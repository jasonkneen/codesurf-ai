    "diffRemovedBg": {
      "dark": "#3d1319",
      "light": "#ffeef0"
    },
    "diffContextBg": {
      "dark": "backgroundPanel",
      "light": "#f6f8fa"
    },
    "diffLineNumber": {
      "dark": "#30363d",
      "light": "#d1d5da"
    },
    "diffAddedLineNumberBg": {
      "dark": "#0d3320",
      "light": "#e6ffed"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#3d1319",
      "light": "#ffeef0"
    },
    "markdownText": {
      "dark": "foreground",
      "light": "#24292e"
    },
    "markdownHeading": {
      "dark": "obsidianPurple",
      "light": "#6f42c1"
    },
    "markdownLink": {
      "dark": "obsidianBlue",
      "light": "#0366d6"
    },
    "markdownLinkText": {
      "dark": "obsidianCyan",
      "light": "#0598bc"
    },
    "markdownCode": {
      "dark": "obsidianGreen",
      "light": "#28a745"
    },
    "markdownBlockQuote": {
      "dark": "foregroundMuted",
      "light": "#6a737d"
    },
    "markdownEmph": {
      "dark": "obsidianYellow",
      "light": "#dbab09"
    },
    "markdownStrong": {
      "dark": "obsidianOrange",
      "light": "#e36209"
    },
    "markdownHorizontalRule": {
      "dark": "#30363d",
      "light": "#e1e4e8"
    },
    "markdownListItem": {
      "dark": "obsidianBlue",
      "light": "#0366d6"
    },
    "markdownListEnumeration": {
      "dark": "obsidianCyan",
      "light": "#0598bc"
    },
    "markdownImage": {
      "dark": "obsidianBlue",
      "light": "#0366d6"
    },
    "markdownImageText": {
      "dark": "obsidianCyan",
      "light": "#0598bc"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "#24292e"
    },
    "syntaxComment": {
      "dark": "foregroundMuted",
      "light": "#6a737d"
    },
    "syntaxKeyword": {
      "dark": "obsidianPink",
      "light": "#d73a49"
    },
    "syntaxFunction": {
      "dark": "obsidianBlue",
      "light": "#0366d6"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#24292e"
    },
    "syntaxString": {
      "dark": "obsidianGreen",
      "light": "#28a745"
    },
    "syntaxNumber": {
      "dark": "obsidianOrange",
      "light": "#e36209"
    },
    "syntaxType": {
      "dark": "obsidianCyan",
      "light": "#0598bc"
    },
    "syntaxOperator": {
      "dark": "obsidianPurple",
      "light": "#6f42c1"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#24292e"
    }
  }
}
