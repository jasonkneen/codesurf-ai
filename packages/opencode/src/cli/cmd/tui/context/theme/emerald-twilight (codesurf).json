{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#0d1b1e",
    "backgroundPanel": "#122329",
    "backgroundElement": "#172c34",
    "foreground": "#d8e9e7",
    "foregroundMuted": "#8ba8a3",
    "emeraldGreen": "#50fa7b",
    "emeraldTeal": "#5af0c8",
    "emeraldMint": "#7ee8c8",
    "emeraldCyan": "#8be9fd",
    "emeraldBlue": "#6db5e8",
    "emeraldYellow": "#cfdf8f",
    "emeraldPurple": "#bd93f9"
  },
  "theme": {
    "primary": {
      "dark": "emeraldTeal",
      "light": "#00897b"
    },
    "secondary": {
      "dark": "emeraldPurple",
      "light": "#7b1fa2"
    },
    "accent": {
      "dark": "emeraldMint",
      "light": "#00796b"
    },
    "error": {
      "dark": "#ff6b7a",
      "light": "#d32f2f"
    },
    "warning": {
      "dark": "emeraldYellow",
      "light": "#f57f17"
    },
    "success": {
      "dark": "emeraldGreen",
      "light": "#388e3c"
    },
    "info": {
      "dark": "emeraldCyan",
      "light": "#0288d1"
    },
    "text": {
      "dark": "foreground",
      "light": "#0d1b1e"
