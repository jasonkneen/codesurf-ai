      "dark": "foregroundMuted",
      "light": "#546e7a"
    },
    "syntaxKeyword": {
      "dark": "emeraldPurple",
      "light": "#7b1fa2"
    },
    "syntaxFunction": {
      "dark": "emeraldBlue",
      "light": "#1976d2"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#0d1b1e"
    },
    "syntaxString": {
      "dark": "emeraldGreen",
      "light": "#388e3c"
    },
    "syntaxNumber": {
      "dark": "emeraldYellow",
      "light": "#f57f17"
    },
    "syntaxType": {
      "dark": "emeraldTeal",
      "light": "#00897b"
    },
    "syntaxOperator": {
      "dark": "emeraldMint",
      "light": "#00796b"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#0d1b1e"
    }
