      "dark": "graphite7",
      "light": "#4d4d57"
    },
    "syntaxFunction": {
      "dark": "graphite8",
      "light": "#6b6b75"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#121214"
