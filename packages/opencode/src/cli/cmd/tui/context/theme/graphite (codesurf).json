    "syntaxString": {
      "dark": "graphite6",
      "light": "#6b6b75"
    },
    "syntaxNumber": {
      "dark": "graphite7",
      "light": "#6b6b75"
    },
    "syntaxType": {
      "dark": "graphite8",
      "light": "#4d4d57"
    },
    "syntaxOperator": {
      "dark": "graphite7",
      "light": "#6b6b75"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#121214"
    }
