{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#121214",
    "backgroundPanel": "#18181b",
    "backgroundElement": "#1f1f23",
    "foreground": "#e0e0e3",
    "foregroundMuted": "#90909a",
    "graphite1": "#25252a",
    "graphite2": "#2f2f36",
    "graphite3": "#3c3c45",
    "graphite4": "#4d4d58",
    "graphite5": "#62626f",
    "graphite6": "#82828f",
    "graphite7": "#adadb8",
    "graphite8": "#cfcfd7",
    "graphiteWhite": "#f0f0f4"
  },
  "theme": {
    "primary": {
      "dark": "graphite7",
      "light": "#6b6b75"
    },
    "secondary": {
      "dark": "graphite6",
      "light": "#4d4d57"
    },
    "accent": {
      "dark": "graphiteWhite",
      "light": "#3a3a42"
    },
    "error": {
      "dark": "graphite8",
      "light": "#4d4d57"
    },
    "warning": {
      "dark": "graphite7",
      "light": "#6b6b75"
    },
    "success": {
      "dark": "graphite6",
      "light": "#4d4d57"
