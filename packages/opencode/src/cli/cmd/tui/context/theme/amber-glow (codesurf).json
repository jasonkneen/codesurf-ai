{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1a1510",
    "backgroundPanel": "#24201a",
    "backgroundElement": "#2f2a24",
    "foreground": "#f5e6d3",
    "foregroundMuted": "#b8a28e",
    "amberOrange": "#ffb86c",
    "amberGold": "#f9cb8f",
    "amberYellow": "#ffe066",
    "amberBrown": "#d4a574",
    "amberPeach": "#ffb380",
    "amberRed": "#ff8a65",
    "amberPurple": "#d4a5d4"
  },
  "theme": {
    "primary": {
      "dark": "amberOrange",
      "light": "#ef6c00"
    },
    "secondary": {
      "dark": "amberPurple",
      "light": "#8e24aa"
    },
    "accent": {
      "dark": "amberGold",
      "light": "#f57c00"
    },
    "error": {
      "dark": "amberRed",
      "light": "#d84315"
    },
    "warning": {
      "dark": "amberYellow",
      "light": "#f57f17"
    },
    "success": {
      "dark": "#a7c080",
      "light": "#388e3c"
    },
    "info": {
      "dark": "amberBrown",
      "light": "#5d4037"
    },
    "text": {
      "dark": "foreground",
      "light": "#1a1510"
    },
    "textMuted": {
