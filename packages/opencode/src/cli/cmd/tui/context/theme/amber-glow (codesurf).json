    "syntaxFunction": {
      "dark": "amberGold",
      "light": "#f57c00"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#1a1510"
    },
    "syntaxString": {
      "dark": "amberYellow",
      "light": "#f57f17"
    },
    "syntaxNumber": {
      "dark": "amberPeach",
      "light": "#ff6f00"
    },
    "syntaxType": {
      "dark": "amberBrown",
      "light": "#5d4037"
    },
    "syntaxOperator": {
      "dark": "amberOrange",
      "light": "#ef6c00"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#1a1510"
    }
