    "syntaxNumber": {
      "dark": "sunsetOrange",
      "light": "#f57c00"
    },
    "syntaxType": {
      "dark": "sunsetPurple",
      "light": "#8e24aa"
    },
    "syntaxOperator": {
      "dark": "sunsetRose",
      "light": "#e91e63"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#1f1721"
