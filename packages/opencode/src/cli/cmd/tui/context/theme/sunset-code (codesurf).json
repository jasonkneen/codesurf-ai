{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1f1721",
    "backgroundPanel": "#281f2b",
    "backgroundElement": "#322837",
    "foreground": "#f4e5d9",
    "foregroundMuted": "#b89fa0",
    "sunsetOrange": "#ff9e64",
