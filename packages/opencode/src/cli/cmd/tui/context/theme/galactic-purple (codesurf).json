    "diffRemovedBg": {
      "dark": "#280a18",
      "light": "#fce4ec"
    },
    "diffContextBg": {
      "dark": "backgroundPanel",
      "light": "#f0f0f0"
    },
    "diffLineNumber": {
      "dark": "#372454",
      "light": "#b0b0b0"
    },
    "diffAddedLineNumberBg": {
      "dark": "#0a2820",
      "light": "#e8f5e9"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#280a18",
      "light": "#fce4ec"
    },
    "markdownText": {
      "dark": "foreground",
      "light": "#160b28"
    },
    "markdownHeading": {
      "dark": "galacticMagenta",
      "light": "#ad1457"
    },
    "markdownLink": {
      "dark": "galacticBlue",
      "light": "#3949ab"
    },
    "markdownLinkText": {
      "dark": "galacticCyan",
      "light": "#1976d2"
    },
    "markdownCode": {
      "dark": "#8ff9c8",
      "light": "#388e3c"
    },
    "markdownBlockQuote": {
      "dark": "foregroundMuted",
      "light": "#6a1b9a"
    },
    "markdownEmph": {
      "dark": "galacticPink",
      "light": "#c2185b"
    },
    "markdownStrong": {
      "dark": "galacticLavender",
      "light": "#7b1fa2"
    },
    "markdownHorizontalRule": {
      "dark": "#372454",
      "light": "#d0d0d0"
    },
    "markdownListItem": {
      "dark": "galacticBlue",
      "light": "#3949ab"
    },
    "markdownListEnumeration": {
      "dark": "galacticPurple",
      "light": "#7b1fa2"
    },
    "markdownImage": {
      "dark": "galacticBlue",
      "light": "#3949ab"
    },
    "markdownImageText": {
      "dark": "galacticCyan",
      "light": "#1976d2"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "#160b28"
    },
    "syntaxComment": {
      "dark": "foregroundMuted",
      "light": "#6a1b9a"
    },
    "syntaxKeyword": {
      "dark": "galacticMagenta",
      "light": "#ad1457"
    },
    "syntaxFunction": {
      "dark": "galacticBlue",
      "light": "#3949ab"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#160b28"
    },
    "syntaxString": {
      "dark": "#8ff9c8",
      "light": "#388e3c"
    },
    "syntaxNumber": {
      "dark": "#ffb86c",
      "light": "#ef6c00"
    },
    "syntaxType": {
      "dark": "galacticCyan",
      "light": "#1976d2"
    },
    "syntaxOperator": {
      "dark": "galacticPink",
      "light": "#c2185b"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#160b28"
    }
  }
}
