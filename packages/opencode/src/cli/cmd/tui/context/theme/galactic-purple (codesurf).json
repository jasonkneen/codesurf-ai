    "diffHighlightAdded": {
      "dark": "#afffdb",
      "light": "#66bb6a"
    },
    "diffHighlightRemoved": {
      "dark": "#ff8eb5",
      "light": "#ef5350"
    },
    "diffAddedBg": {
      "dark": "#0a2820",
      "light": "#e8f5e9"
