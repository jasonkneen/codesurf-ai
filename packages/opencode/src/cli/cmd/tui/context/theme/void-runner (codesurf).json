    "diffHighlightRemoved": {
      "dark": "#ff8599",
      "light": "#ef5350"
    },
    "diffAddedBg": {
      "dark": "#0a2010",
      "light": "#e8f5e9"
    },
    "diffRemovedBg": {
      "dark": "#200a10",
      "light": "#ffebee"
    },
    "diffContextBg": {
      "dark": "backgroundPanel",
      "light": "#f0f0f0"
    },
    "diffLineNumber": {
      "dark": "#1a1a30",
      "light": "#b0b0b0"
    },
    "diffAddedLineNumberBg": {
      "dark": "#0a2010",
      "light": "#e8f5e9"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#200a10",
      "light": "#ffebee"
    },
    "markdownText": {
      "dark": "foreground",
      "light": "#050510"
    },
    "markdownHeading": {
      "dark": "voidPurple",
      "light": "#8e24aa"
    },
    "markdownLink": {
      "dark": "voidBlue",
      "light": "#1976d2"
    },
    "markdownLinkText": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "markdownCode": {
      "dark": "voidGreen",
      "light": "#388e3c"
    },
    "markdownBlockQuote": {
      "dark": "foregroundMuted",
      "light": "#616161"
    },
    "markdownEmph": {
      "dark": "voidYellow",
      "light": "#f57f17"
    },
    "markdownStrong": {
      "dark": "voidOrange",
      "light": "#e64a19"
    },
    "markdownHorizontalRule": {
      "dark": "#1a1a30",
      "light": "#d0d0d0"
    },
    "markdownListItem": {
      "dark": "voidBlue",
      "light": "#1976d2"
    },
    "markdownListEnumeration": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "markdownImage": {
      "dark": "voidBlue",
      "light": "#1976d2"
    },
    "markdownImageText": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "#050510"
    },
    "syntaxComment": {
      "dark": "foregroundMuted",
      "light": "#616161"
    },
    "syntaxKeyword": {
      "dark": "voidPurple",
      "light": "#8e24aa"
    },
    "syntaxFunction": {
      "dark": "voidBlue",
      "light": "#1976d2"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#050510"
    },
    "syntaxString": {
      "dark": "voidGreen",
      "light": "#388e3c"
    },
    "syntaxNumber": {
      "dark": "voidOrange",
      "light": "#e64a19"
    },
    "syntaxType": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "syntaxOperator": {
      "dark": "voidPink",
      "light": "#ec407a"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#050510"
    }
  }
}
