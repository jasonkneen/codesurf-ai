{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#050510",
    "backgroundPanel": "#0a0a1a",
    "backgroundElement": "#101020",
    "foreground": "#e6e6fa",
    "foregroundMuted": "#9090b0",
    "voidPurple": "#c792ea",
    "voidBlue": "#82aaff",
    "voidCyan": "#89ddff",
    "voidGreen": "#c3e88d",
    "voidYellow": "#ffcb6b",
    "voidRed": "#ff5370",
    "voidOrange": "#f78c6c",
    "voidPink": "#ff9cac",
    "deepVoid": "#020208"
  },
  "theme": {
    "primary": {
      "dark": "voidBlue",
      "light": "#1976d2"
    },
    "secondary": {
      "dark": "voidPurple",
      "light": "#8e24aa"
    },
    "accent": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "error": {
      "dark": "voidRed",
      "light": "#d32f2f"
    },
    "warning": {
      "dark": "voidYellow",
      "light": "#f57f17"
    },
    "success": {
      "dark": "voidGreen",
      "light": "#388e3c"
    },
    "info": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "text": {
      "dark": "foreground",
      "light": "#050510"
    },
    "textMuted": {
      "dark": "foregroundMuted",
      "light": "#616161"
    },
    "background": {
      "dark": "background",
      "light": "#fafafa"
    },
    "backgroundPanel": {
      "dark": "backgroundPanel",
      "light": "#f0f0f0"
    },
    "backgroundElement": {
      "dark": "backgroundElement",
      "light": "#e8e8e8"
    },
    "border": {
      "dark": "#1a1a30",
      "light": "#d0d0d0"
    },
    "borderActive": {
      "dark": "voidCyan",
      "light": "#00acc1"
    },
    "borderSubtle": {
      "dark": "#0f0f1a",
      "light": "#e8e8e8"
    },
    "diffAdded": {
      "dark": "voidGreen",
      "light": "#388e3c"
