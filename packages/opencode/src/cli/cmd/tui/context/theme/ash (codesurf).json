      "dark": "ash6",
      "light": "#65657d"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "#1a1a1e"
    },
    "syntaxComment": {
      "dark": "ash5",
      "light": "#9f9faa"
