    "syntaxKeyword": {
      "dark": "ash7",
      "light": "#47475d"
    },
    "syntaxFunction": {
      "dark": "ash8",
      "light": "#65657d"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#1a1a1e"
    },
    "syntaxString": {
      "dark": "ash6",
      "light": "#65657d"
    },
    "syntaxNumber": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "syntaxType": {
      "dark": "ash8",
      "light": "#47475d"
    },
    "syntaxOperator": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#1a1a1e"
    }
  }
}
