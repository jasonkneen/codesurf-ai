{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1a1a1e",
    "backgroundPanel": "#202026",
    "backgroundElement": "#27272f",
    "foreground": "#d8d8dc",
    "foregroundMuted": "#98989f",
    "ash1": "#2e2e36",
    "ash2": "#39393f",
    "ash3": "#474750",
    "ash4": "#5a5a64",
    "ash5": "#72727d",
    "ash6": "#9292a0",
    "ash7": "#b8b8c2",
    "ash8": "#dbdbe0",
    "ashWhite": "#eaeaed"
  },
  "theme": {
    "primary": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "secondary": {
      "dark": "ash6",
      "light": "#47475d"
    },
    "accent": {
      "dark": "ashWhite",
      "light": "#35354d"
    },
    "error": {
      "dark": "ash8",
      "light": "#47475d"
    },
    "warning": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "success": {
      "dark": "ash6",
      "light": "#47475d"
    },
    "info": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "text": {
      "dark": "foreground",
      "light": "#1a1a1e"
