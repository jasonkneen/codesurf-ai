    "markdownEmph": {
      "dark": "ash7",
      "light": "#65657d"
    },
    "markdownStrong": {
      "dark": "ashWhite",
      "light": "#35354d"
    },
    "markdownHorizontalRule": {
      "dark": "ash3",
      "light": "#cfcfd9"
