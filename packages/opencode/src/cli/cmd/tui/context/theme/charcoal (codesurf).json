      "dark": "charcoal7",
      "light": "#4a4a5a"
    },
    "syntaxFunction": {
      "dark": "charcoal8",
      "light": "#68687a"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#16161a"
    },
    "syntaxString": {
      "dark": "charcoal6",
      "light": "#68687a"
    },
    "syntaxNumber": {
      "dark": "charcoal7",
      "light": "#68687a"
    },
    "syntaxType": {
      "dark": "charcoal8",
      "light": "#4a4a5a"
    },
    "syntaxOperator": {
      "dark": "charcoal7",
      "light": "#68687a"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#16161a"
    }
