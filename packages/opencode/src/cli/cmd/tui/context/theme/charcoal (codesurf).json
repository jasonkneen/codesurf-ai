{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#16161a",
    "backgroundPanel": "#1c1c22",
    "backgroundElement": "#23232b",
    "foreground": "#dcdce0",
    "foregroundMuted": "#94949e",
    "charcoal1": "#2a2a33",
    "charcoal2": "#35353f",
    "charcoal3": "#42424e",
    "charcoal4": "#545461",
    "charcoal5": "#6a6a78",
    "charcoal6": "#8a8a98",
    "charcoal7": "#b3b3bd",
    "charcoal8": "#d6d6dc",
    "charcoalWhite": "#ededf0"
  },
  "theme": {
    "primary": {
      "dark": "charcoal7",
      "light": "#68687a"
    },
    "secondary": {
      "dark": "charcoal6",
      "light": "#4a4a5a"
    },
    "accent": {
      "dark": "charcoalWhite",
      "light": "#37374a"
    },
    "error": {
      "dark": "charcoal8",
      "light": "#4a4a5a"
    },
    "warning": {
      "dark": "charcoal7",
      "light": "#68687a"
    },
    "success": {
      "dark": "charcoal6",
      "light": "#4a4a5a"
    },
    "info": {
      "dark": "charcoal7",
      "light": "#68687a"
    },
    "text": {
      "dark": "foreground",
      "light": "#16161a"
    },
    "textMuted": {
