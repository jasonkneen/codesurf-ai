      "dark": "oceanBlue",
      "light": "#0277bd"
    },
    "secondary": {
      "dark": "oceanPurple",
      "light": "#5e35b1"
    },
    "accent": {
      "dark": "oceanCyan",
      "light": "#00838f"
    },
    "error": {
      "dark": "#fa5252",
      "light": "#d32f2f"
    },
    "warning": {
      "dark": "#ffd43b",
      "light": "#f57f17"
    },
    "success": {
