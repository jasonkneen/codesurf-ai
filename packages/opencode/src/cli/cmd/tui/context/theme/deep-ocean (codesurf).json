      "dark": "oceanBlue",
      "light": "#0277bd"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#001824"
    },
    "syntaxString": {
      "dark": "oceanTeal",
      "light": "#2e7d32"
    },
    "syntaxNumber": {
      "dark": "#ffd43b",
      "light": "#f57f17"
    },
    "syntaxType": {
      "dark": "oceanAqua",
      "light": "#0288d1"
    },
    "syntaxOperator": {
      "dark": "oceanCyan",
      "light": "#00838f"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#001824"
    }
