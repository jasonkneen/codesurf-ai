{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#001824",
    "backgroundPanel": "#0a202e",
    "backgroundElement": "#112938",
    "foreground": "#d4e6f1",
    "foregroundMuted": "#85a1b3",
    "oceanBlue": "#4dabf7",
