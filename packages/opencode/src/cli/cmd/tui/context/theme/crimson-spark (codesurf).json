      "light": "#7b1fa2"
    },
    "markdownLinkText": {
      "dark": "crimsonPurple",
      "light": "#ad1457"
    },
    "markdownCode": {
      "dark": "crimsonGold",
      "light": "#f57f17"
    },
    "markdownBlockQuote": {
      "dark": "foregroundMuted",
      "light": "#795548"
    },
    "markdownEmph": {
      "dark": "crimsonMagenta",
      "light": "#e91e63"
