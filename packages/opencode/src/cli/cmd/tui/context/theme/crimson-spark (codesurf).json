      "dark": "foreground",
      "light": "#1a0d14"
    },
    "syntaxComment": {
      "dark": "foregroundMuted",
      "light": "#795548"
    },
    "syntaxKeyword": {
      "dark": "crimsonPink",
      "light": "#c2185b"
    },
    "syntaxFunction": {
      "dark": "crimsonLavender",
      "light": "#7b1fa2"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#1a0d14"
    },
    "syntaxString": {
      "dark": "crimsonGold",
      "light": "#f57f17"
    },
    "syntaxNumber": {
      "dark": "crimsonOrange",
      "light": "#e65100"
    },
    "syntaxType": {
      "dark": "crimsonPurple",
      "light": "#ad1457"
    },
    "syntaxOperator": {
      "dark": "crimsonMagenta",
      "light": "#e91e63"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#1a0d14"
    }
  }
}
