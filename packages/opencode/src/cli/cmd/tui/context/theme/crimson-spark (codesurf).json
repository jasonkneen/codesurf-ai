{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1a0d14",
    "backgroundPanel": "#24141d",
    "backgroundElement": "#2f1a27",
    "foreground": "#f5e1e8",
    "foregroundMuted": "#b89099",
    "crimsonRed": "#ff4057",
    "crimsonPink": "#ff5f87",
    "crimsonOrange": "#ff7f3f",
    "crimsonPurple": "#d47fb8",
    "crimsonMagenta": "#ff3f8f",
    "crimsonGold": "#ffb347",
    "crimsonLavender": "#cf9fff"
  },
  "theme": {
    "primary": {
      "dark": "crimsonRed",
      "light": "#d32f2f"
    },
    "secondary": {
      "dark": "crimsonPurple",
      "light": "#ad1457"
    },
    "accent": {
      "dark": "crimsonPink",
      "light": "#c2185b"
    },
    "error": {
      "dark": "crimsonRed",
      "light": "#b71c1c"
    },
    "warning": {
      "dark": "crimsonOrange",
      "light": "#e65100"
    },
    "success": {
      "dark": "#5fdf9f",
      "light": "#388e3c"
    },
    "info": {
      "dark": "crimsonLavender",
      "light": "#7b1fa2"
    },
    "text": {
      "dark": "foreground",
      "light": "#1a0d14"
    },
    "textMuted": {
      "dark": "foregroundMuted",
      "light": "#795548"
    },
    "background": {
      "dark": "background",
      "light": "#fafafa"
    },
    "backgroundPanel": {
      "dark": "backgroundPanel",
      "light": "#f0f0f0"
    },
    "backgroundElement": {
      "dark": "backgroundElement",
      "light": "#e8e8e8"
    },
    "border": {
      "dark": "#3d2530",
      "light": "#d0d0d0"
    },
    "borderActive": {
      "dark": "crimsonPink",
      "light": "#c2185b"
    },
    "borderSubtle": {
      "dark": "#2a181f",
      "light": "#e8e8e8"
    },
    "diffAdded": {
      "dark": "#5fdf9f",
      "light": "#388e3c"
