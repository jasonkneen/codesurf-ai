{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-openai-codex-auth"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "$ANTHROPIC_API_KEY"
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "mgrep": {
      "type": "local",
      "command": [
        "/Users/jkneen/Documents/GitHub/flows/ai-cluso/packages/mgrep-local/dist/mcp/cli.js"
      ]
    },
    "bread": {
      "type": "remote",
      "url": "https://mcp.bread.com.ai",
      "headers": {
        "Authorization": "Bearer sk-iuXbELV4oNMzjYMF9W4Vrg"
      }
    },
    "morph": {
      "type": "local",
      "command": [
        "bunx",
        "@morphllm/morphmcp"
      ],
      "environment": {
        "ENABLED_TOOLS": "warp_grep"
      }
    }
  },
  "favoriteTools": [
    "cc_computer_use",
    "write",
    "cc_bash",
    "add_memory",
    "todoread",
    "switch_mode",
    "todowrite",
    "cc_write",
    "cc_glob",
    "ripgrep",
    "mgrep_index_status"
  ]
}